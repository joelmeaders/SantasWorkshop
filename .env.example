# -----------------------------------------------------------------------------
# Angular Firebase client config
# -----------------------------------------------------------------------------
# Local development and TEST/QA builds use the TEST_ values.
# Production builds use the PROD_ values.
# The shared Firebase config generator also accepts the unprefixed FIREBASE_* keys
# as a compatibility fallback for environment-specific CI jobs.

TEST_FIREBASE_API_KEY=replace-with-test-firebase-api-key
TEST_FIREBASE_AUTH_DOMAIN=santas-workshop-test.firebaseapp.com
TEST_FIREBASE_DATABASE_URL=https://santas-workshop-test-default-rtdb.firebaseio.com
TEST_FIREBASE_PROJECT_ID=santas-workshop-test
TEST_FIREBASE_STORAGE_BUCKET=santas-workshop-test.appspot.com
TEST_FIREBASE_MESSAGING_SENDER_ID=312672416598
TEST_FIREBASE_APP_ID=1:312672416598:web:75721875d43341bef29cf7
TEST_FIREBASE_MEASUREMENT_ID=G-4FQR667VT9

PROD_FIREBASE_API_KEY=replace-with-prod-firebase-api-key
PROD_FIREBASE_AUTH_DOMAIN=santas-workshop-193b5.firebaseapp.com
PROD_FIREBASE_DATABASE_URL=https://santas-workshop-193b5.firebaseio.com
PROD_FIREBASE_PROJECT_ID=santas-workshop-193b5
PROD_FIREBASE_STORAGE_BUCKET=santas-workshop-193b5.appspot.com
PROD_FIREBASE_MESSAGING_SENDER_ID=397997267986
PROD_FIREBASE_APP_ID=1:397997267986:web:8c85e08550793dd348cccb
PROD_FIREBASE_MEASUREMENT_ID=G-0KHS1T1W85

# -----------------------------------------------------------------------------
# Firebase Functions local placeholders
# -----------------------------------------------------------------------------
# Functions currently consume unprefixed runtime variables.
# If test and production need different values, you can optionally provide
# prefixed overrides and generate per-project files with:
# - `pnpm run config:functions:test`
# - `pnpm run config:functions:prod`
#
# Examples:
# TEST_ADMIN_BOOTSTRAP_PASSWORD=replace-with-test-password
# PROD_ADMIN_BOOTSTRAP_PASSWORD=replace-with-prod-password
# TEST_FIRESTORE_BACKUP_BUCKET=gs://santashop-backups-test
# PROD_FIRESTORE_BACKUP_BUCKET=gs://santashop-backups-prod

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
ADMIN_UIDS=bIMHv99EssTqMfhX2kkYm2vErwu1,xkeLDNPTVVPkt6Onh4EGYNuGi2C2,sGVW9Om1E5UGKWcq97EpygbwQfl2,2kNkKB4Xz5agjs6TfXzQStJ38gx1,RDkrgjJE0oQAXY6peLoABJvOH2j2
ADMIN_BOOTSTRAP_PASSWORD=replace-with-local-admin-bootstrap-password
SANTASHOP_PROGRAM_YEAR=2025
SANTASHOP_TIME_ZONE=America/Denver
SANTASHOP_TIME_OFFSET=-07:00
SANTASHOP_SHOP_DAYS=12-12,12-13,12-15,12-16
SANTASHOP_DEFAULT_MAX_SLOTS=350
FIRESTORE_BACKUP_BUCKET=gs://santashop-backups
SES_REGION=us-west-2
# Optional fallback if you want one shared AWS SDK region value:
# AWS_REGION=us-west-2
REGISTRATION_EMAIL_TEMPLATE=dscs-registration-confirmation-v1
REMINDER_EMAIL_TEMPLATE=dscs-event-reminder
SANTASHOP_EVENT_DISPLAY_NAME=2025 Denver Santa Claus Shop
REMINDER_EMAIL_SENDING_STALE_MINUTES=15
REGISTRATION_EMAIL_SOURCE=noreply@denversantaclausshop.org
REGISTRATION_EMAIL_RETURN_PATH=admin@denversantaclausshop.org
