# -----------------------------------------------------------------------------
# Angular Firebase client config
# -----------------------------------------------------------------------------
# Development and TEST/QA builds use TEST_ values; emulator builds use demo-santashop.
# Production builds use the PROD_ values.

TEST_FIREBASE_API_KEY=replace-with-test-firebase-api-key
TEST_FIREBASE_AUTH_DOMAIN=santas-workshop-test.firebaseapp.com
TEST_FIREBASE_DATABASE_URL=https://santas-workshop-test-default-rtdb.firebaseio.com
TEST_FIREBASE_PROJECT_ID=santas-workshop-test
TEST_FIREBASE_STORAGE_BUCKET=santas-workshop-test.appspot.com
TEST_FIREBASE_MESSAGING_SENDER_ID=312672416598
TEST_FIREBASE_APP_ID=1:312672416598:web:75721875d43341bef29cf7
TEST_FIREBASE_MEASUREMENT_ID=G-4FQR667VT9

PROD_FIREBASE_API_KEY=replace-with-prod-firebase-api-key
PROD_FIREBASE_AUTH_DOMAIN=santas-workshop-193b5.firebaseapp.com
PROD_FIREBASE_DATABASE_URL=https://santas-workshop-193b5.firebaseio.com
PROD_FIREBASE_PROJECT_ID=santas-workshop-193b5
PROD_FIREBASE_STORAGE_BUCKET=santas-workshop-193b5.appspot.com
PROD_FIREBASE_MESSAGING_SENDER_ID=397997267986
PROD_FIREBASE_APP_ID=1:397997267986:web:8c85e08550793dd348cccb
PROD_FIREBASE_MEASUREMENT_ID=G-0KHS1T1W85

# GitHub Actions service-account secrets
# Store each service-account JSON value on one line.
FIREBASE_SERVICE_ACCOUNT_SANTAS_WORKSHOP_TEST=replace-with-single-line-test-service-account-json
FIREBASE_SERVICE_ACCOUNT_SANTAS_WORKSHOP_193B5=replace-with-single-line-prod-service-account-json

# Functions input configuration
# Select LOCAL_, TEST_, or PROD_ with config:functions:local, :test, or :prod.
# Firebase supplies the generated unprefixed variables to the runtime.
# Email delivery requires published templates in the admin template editor.

# LOCAL Functions values
LOCAL_AWS_ACCESS_KEY_ID=emulator-only-key
LOCAL_AWS_SECRET_ACCESS_KEY=emulator-only-secret
LOCAL_SANTASHOP_PROGRAM_YEAR=2026
LOCAL_SANTASHOP_TIME_ZONE=America/Denver
LOCAL_SANTASHOP_SHOP_DAYS=12-12,12-13,12-15,12-16
LOCAL_SANTASHOP_DEFAULT_MAX_SLOTS=350
LOCAL_FIRESTORE_BACKUP_BUCKET=gs://santashop-backups
LOCAL_SES_REGION=us-west-2
LOCAL_SANTASHOP_EVENT_DISPLAY_NAME=2026 Denver Santa Claus Shop
LOCAL_REMINDER_EMAIL_SENDING_STALE_MINUTES=15
LOCAL_SANTASHOP_SIGNUP_MIN_INSTANCES=0
LOCAL_SANTASHOP_EVENT_MIN_INSTANCES=0
LOCAL_REGISTRATION_EMAIL_SOURCE=noreply@denversantaclausshop.org
LOCAL_REGISTRATION_EMAIL_RETURN_PATH=admin@denversantaclausshop.org
LOCAL_SCHEDULED_FIRESTORE_BACKUP=0 0 * 11,12 *
LOCAL_SCHEDULED_DATETIME_SLOT_COUNTERS=*/5 * * 11,12 *
LOCAL_SCHEDULED_REGISTRATION_STATS=59 23 * * *
LOCAL_SCHEDULED_USER_STATS=55 23 * 11,12 *
LOCAL_SCHEDULED_CHECKIN_STATS=*/5 10,11,12,13,14,15,16 12,13,15,16 12 *
# LOCAL_SANTASHOP_FUNCTIONS_SERVICE_ACCOUNT=santashop-functions-runtime@example-project.iam.gserviceaccount.com

