{
	"functions": {
		"source": "santashop-functions",
		"runtime": "nodejs24"
	},
	"emulators": {
		"functions": {
			"port": 5001
		},
		"firestore": {
			"host": "127.0.0.1",
			"port": 8180
		},
		"ui": {
			"enabled": false
		},
		"auth": {
			"port": 9099
		},
		"storage": {
			"port": 9199
		},
		"singleProjectMode": true
	},
	"storage": {
		"rules": "storage.rules"
	},
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	}
}
