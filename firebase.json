{
	"hosting": [
		{
			"target": "santashop-app",
			"public": "dist/santashop-app",
			"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
			"headers": [
				{
					"source": "*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].+(css|js)",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "public,max-age=31536000,immutable"
						}
					]
				},
				{
					"source": "/@(ngsw-worker.js|ngsw.json)",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "no-cache"
						}
					]
				}
			],
			"rewrites": [
				{
					"source": "/changeAccountInformation",
					"function": {
						"functionId": "changeAccountInformation",
						"region": "us-central1"
					}
				},
				{
					"source": "/completeRegistration",
					"function": {
						"functionId": "completeRegistration",
						"region": "us-central1"
					}
				},
				{
					"source": "/newAccount",
					"function": {
						"functionId": "newAccount",
						"region": "us-central1"
					}
				},
				{
					"source": "/undoRegistration",
					"function": {
						"functionId": "undoRegistration",
						"region": "us-central1"
					}
				},
				{
					"source": "/changeRegistrationDateTime",
					"function": {
						"functionId": "changeRegistrationDateTime",
						"region": "us-central1"
					}
				},
				{
					"source": "/updateEmailAddress",
					"function": {
						"functionId": "updateEmailAddress",
						"region": "us-central1"
					}
				},
				{
					"source": "/updateReferredBy",
					"function": {
						"functionId": "updateReferredBy",
						"region": "us-central1"
					}
				},
				{
					"source": "**",
					"destination": "/index.html"
				}
			]
		},
		{
			"target": "santashop-admin",
			"public": "dist/santashop-admin",
			"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
			"headers": [
				{
					"source": "*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].+(css|js)",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "public,max-age=31536000,immutable"
						}
					]
				},
				{
					"source": "/@(ngsw-worker.js|ngsw.json)",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "no-cache"
						}
					]
				}
			],
			"rewrites": [
				{
					"source": "/checkIn",
					"function": {
						"functionId": "checkIn",
						"region": "us-central1"
					}
				},
				{
					"source": "/checkInWithEdit",
					"function": {
						"functionId": "checkInWithEdit",
						"region": "us-central1"
					}
				},
				{
					"source": "/onSiteRegistration",
					"function": {
						"functionId": "onSiteRegistration",
						"region": "us-central1"
					}
				},
				{
					"source": "/undoRegistration",
					"function": {
						"functionId": "undoRegistration",
						"region": "us-central1"
					}
				},
				{
					"source": "/callableAdminPreRegister",
					"function": {
						"functionId": "callableAdminPreRegister",
						"region": "us-central1"
					}
				},
				{
					"source": "/callableResendRegistrationEmail",
					"function": {
						"functionId": "callableResendRegistrationEmail",
						"region": "us-central1"
					}
				},
				{
					"source": "/changeRegistrationDateTime",
					"function": {
						"functionId": "changeRegistrationDateTime",
						"region": "us-central1"
					}
				},
				{
					"source": "**",
					"destination": "/index.html"
				}
			]
		}
	],
	"functions": {
		"runtime": "nodejs22",
		"predeploy": [
			"node \"$PROJECT_DIR/scripts/assert-functions-deploy-ci.cjs\"",
			"npm --prefix \"$RESOURCE_DIR\" run lint",
			"npm --prefix \"$RESOURCE_DIR\" run build"
		],
		"source": "santashop-functions"
	},
	"emulators": {
		"functions": {
			"port": 5001
		},
		"firestore": {
			"host": "127.0.0.1",
			"port": 8080
		},
		"hosting": {
			"port": 5000
		},
		"ui": {
			"enabled": true
		},
		"auth": {
			"port": 9099
		},
		"storage": {
			"port": 9199
		},
		"pubsub": {
			"port": 8085
		},
		"database": {
			"port": 9000
		},
		"singleProjectMode": true
	},
	"storage": {
		"rules": "storage.rules"
	},
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"database": {
		"rules": "database.rules.json"
	}
}
