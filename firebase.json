	],
	"functions": {
		"runtime": "nodejs24",
		"predeploy": [
			"node \"$PROJECT_DIR/scripts/assert-functions-deploy-ci.cjs\"",
			"npm --prefix \"$RESOURCE_DIR\" run build"
		],
		"source": "santashop-functions"
	},
	"emulators": {
		"functions": {
			"port": 5001
		},
		"firestore": {
			"host": "127.0.0.1",
			"port": 8080
		},
		"hosting": {
			"port": 5000
		},
		"ui": {
			"enabled": true
		},
		"auth": {
			"port": 9099
		},
		"storage": {
			"port": 9199
		},
		"pubsub": {
			"port": 8085
		},
		"database": {
			"port": 9000
		},
		"singleProjectMode": true
	},
	"storage": {
		"rules": "storage.rules"
	},
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"database": {
		"rules": "database.rules.json"
	}
