rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
	  return isSignedIn() && (
		request.auth.token.owner == true ||
		request.auth.token.admin == true ||
		(request.auth.token.roles is list && request.auth.token.roles.hasAny(['admin']))
	  );
	}

    match /users/{userId} {
      allow get: if isUser(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if isAdmin();
    }

    match /registrations/{documentId} {
      allow read: if isUser(resource.data.uid) || isAdmin();
      allow write: if false;

	  match /mutationReceipts/{mutationId} {
		allow read, write: if false;
	  }
    }

    match /cancellations/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dateTimeSlots/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /checkins/{documentId} {
	  // Check-ins are written only by authoritative callable functions.
	  allow create, update, delete: if false;
      allow read: if isUser(documentId) || isAdmin();
    }

	match /registrationScanAttempts/{documentId} {
	  allow read: if isAdmin();
	  allow write: if false;
	}

	match /registrationScanRiskSummaries/{documentId} {
	  allow read: if isAdmin();
	  allow write: if false;
	}

    match /counters/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /registrationsearchindex/{documentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /emailTemplates/{templateId} {
      allow read, write: if isAdmin();

      match /revisions/{revisionId} {
        allow read, write: if isAdmin();
      }
    }

    match /stats/{document=**} {
      allow read: if isAdmin();
    }

    match /parameters/public {
      allow read: if true;
      allow write: if false;
    }

    match /staff/{userId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    match /ownerOperationPreviews/{document=**} {
      allow read, write: if false;
    }

    match /ownerOperations/{document=**} {
      allow read, write: if false;
    }

    match /ownerOperationLocks/{document=**} {
      allow read, write: if false;
    }
  }
}
