{
	"index": "/index.html",
	"appData": {
		"application": "santashop-admin",
		"updateMessage": "A newer staff app is ready. Refresh to use it."
	},
	"assetGroups": [
		{
			"name": "app-shell",
			"installMode": "prefetch",
			"updateMode": "prefetch",
			"resources": {
				"files": [
					"/index.html",
					"/main*.js",
					"/styles*.css"
				]
			}
		},
		{
			"name": "static-assets",
			"installMode": "lazy",
			"updateMode": "lazy",
			"resources": {
				"files": [
					"/*.js",
					"/*.css",
					"/assets/**",
					"/svg/**"
				]
			}
		}
	]
}
