/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"baseUrl": "..",
		"outDir": "../out-tsc/app",
		"declaration": true,
		"declarationMap": true,
		"inlineSources": true,
		"paths": {
			"@santashop/models": ["dist/@santashop/models"],
			"@santashop/core": ["dist/@santashop/core"]
		}
	},
	"files": ["src/main.ts", "src/polyfills.ts"],
	"exclude": ["src/test.ts", "**/**.spec.ts"]
}
