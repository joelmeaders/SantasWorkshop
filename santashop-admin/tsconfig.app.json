/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"baseUrl": "..",
		"outDir": "../out-tsc/app",
		"declaration": true,
		"declarationMap": true,
		"inlineSources": true,
		"paths": {
			"@santashop/models": ["dist/@santashop/models"],
			"@santashop/core": ["dist/@santashop/core"],
			"@santashop/core/admin": ["santashop-core/src/admin.ts"],
			"@santashop/core/admin/firestore": ["santashop-core/src/admin-firestore.ts"]
		}
	},
	"files": ["src/main.ts"],
	"exclude": ["**/*.spec.ts"],
	"angularCompilerOptions": {
		"extendedDiagnostics": {
			"checks": {
				"nullishCoalescingNotNullable": "suppress",
				"optionalChainNotNullable": "suppress"
			}
		}
	}
}
