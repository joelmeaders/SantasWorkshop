/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"baseUrl": "..",
		"outDir": "../out-tsc/spec",
		"paths": {
			"@santashop/models": ["dist/@santashop/models"],
			"@santashop/core": ["dist/@santashop/core"],
			"@santashop/core/admin": ["santashop-core/src/admin.ts"],
			"@santashop/core/admin/firestore": [
				"santashop-core/src/admin-firestore.ts"
			],
			"test-helpers/*": ["test-helpers/*"]
		},
		"types": ["vitest/globals"]
	},
	"include": [
		"src/**/*.spec.ts",
		"src/**/*.d.ts",
		"src/test-preferences.setup.ts"
	],
	"angularCompilerOptions": {
		"extendedDiagnostics": {
			"checks": {
				"nullishCoalescingNotNullable": "suppress",
				"optionalChainNotNullable": "suppress"
			}
		}
	}
}
