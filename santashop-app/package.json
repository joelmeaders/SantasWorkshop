{
	"name": "@santashop/app",
	"version": "2025.0.0",
	"description": "Coming soon.",
	"main": "index.js",
	"scripts": {
		"lint": "ng lint santashop-app --fix --cache --quiet",
		"test": "ng test santashop-app",
		"start:test": "pnpm prebuild && firebase use santas-workshop-test && ng serve santashop-app --port=4100",
		"config": "ts-node -O {\\\"module\\\":\\\"commonjs\\\"} ./config.client.ts",
		"prebuild": "pnpm --filter @santashop/models build && pnpm --filter @santashop/core build:prod",
		"build:test": "pnpm prebuild && ng build santashop-app --configuration=test",
		"build:prod": "pnpm prebuild && ng build santashop-app --configuration=production",
		"analyze": "ng build santashop-app --configuration=production --named-chunks=true --stats-json && webpack-bundle-analyzer dist/santashop-app/stats.json",
		"deploy:test": "firebase use santas-workshop-test && firebase target santashop-app && ng build santashop-app --configuration=test && firebase deploy",
		"deploy:test:hosting": "firebase use santas-workshop-test && firebase target santashop-app && ng build santashop-app --configuration=test && firebase deploy --only hosting"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@angular/animations": "*",
		"@angular/common": "*",
		"@angular/core": "*",
		"@angular/fire": "*",
		"@angular/forms": "*",
		"@angular/platform-browser": "*",
		"@angular/router": "*",
		"@ionic/angular": "*",
		"@ngx-translate/core": "*",
		"@ngx-translate/http-loader": "*",
		"firebase": "*",
		"rxfire": "*",
		"rxjs": "*",
		"tslib": "*",
		"zone.js": "*"
	},
	"volta": {
		"node": "24.11.0"
	}
}
