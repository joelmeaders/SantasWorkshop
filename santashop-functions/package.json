{
	"name": "@santashop/functions",
	"scripts": {
		"lint": "eslint --ext .ts . --fix --cache --quiet",
		"build": "webpack",
		"serve": "npm run build && firebase emulators:start --only functions",
		"shell": "npm run build && firebase functions:shell",
		"start": "npm run shell",
		"deploy": "firebase deploy --only functions",
		"logs": "firebase functions:log"
	},
	"engines": {
		"node": "22"
	},
	"main": "dist/index.js",
	"dependencies": {
		"@aws-sdk/client-ses": "catalog:functions",
		"dateformat": "catalog:functions",
		"firebase": "catalog:functions",
		"firebase-admin": "catalog:functions",
		"firebase-functions": "catalog:functions",
		"json2csv": "catalog:functions",
		"qrcode": "catalog:functions",
		"request": "catalog:functions",
		"uuid": "catalog:functions"
	},
	"devDependencies": {
		"@babel/core": "catalog:functions",
		"@babel/plugin-proposal-decorators": "catalog:functions",
		"@babel/preset-env": "catalog:functions",
		"@babel/preset-typescript": "catalog:functions",
		"@types/dateformat": "catalog:functions",
		"@types/json2csv": "catalog:functions",
		"@types/node": "catalog:functions",
		"@types/qrcode": "catalog:functions",
		"@types/request-promise": "catalog:functions",
		"@typescript-eslint/eslint-plugin": "catalog:functions",
		"@typescript-eslint/parser": "catalog:functions",
		"babel-loader": "catalog:functions",
		"core-js": "catalog:functions",
		"eslint": "catalog:functions",
		"eslint-config-google": "catalog:functions",
		"eslint-plugin-import": "catalog:functions",
		"firebase-functions-test": "catalog:functions",
		"ts-loader": "catalog:functions",
		"typescript": "catalog:functions",
		"webpack": "catalog:functions",
		"webpack-cli": "catalog:functions",
		"webpack-sources": "catalog:functions"
	},
	"private": true
}
