rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.owner == true ||
        request.auth.token.admin == true ||
        (request.auth.token.roles is list && request.auth.token.roles.hasAny(['admin']))
      );
    }

    match /registrations/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /registrations/{legacyFileName} {
      allow read: if isSignedIn() && (
        legacyFileName == request.auth.uid + '.png' || isAdmin()
      );
      allow write: if false;
    }
  }
}
